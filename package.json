{
  "name": "tallgrass",
  "version": "1.0.5",
  "description": "Tallgrass: a living-ecosystem simulation game",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "sim": "tsx src/headless/run.ts",
    "batch": "tsx src/headless/batch.ts",
    "capture": "node tools/capture.mjs",
    "deploy": "vite build && wrangler deploy --name tallgrass --assets ./dist --compatibility-date 2026-10-01",
    "test": "tsx tools/run-tests.ts",
    "clean": "node tools/cleanup.mjs",
    "site:build": "node -e \"const fs=require('fs');fs.rmSync('site-dist',{recursive:true,force:true});fs.cpSync('site','site-dist',{recursive:true})\" && node tools/finish-site.mjs site-dist",
    "site:deploy": "npm run site:build && npx --yes wrangler@4 pages deploy site-dist --project-name tallgrass --branch main"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samizdat-Publications/tallgrass.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/Samizdat-Publications/tallgrass/issues"
  },
  "homepage": "https://github.com/Samizdat-Publications/tallgrass#readme",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "three": "^0.186.1"
  },
  "private": true
}
